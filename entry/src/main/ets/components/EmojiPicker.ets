/** `MCEmojiCategoryType` minus frequentlyUsed: its title key, its bar icon, its emojis. */
class EmojiCategory {
  titleKey: string;
  icon: Resource;
  emojis: ArrayDataSource<string>;

  constructor(titleKey: string, icon: Resource, emojis: string) {
    this.titleKey = titleKey;
    this.icon = icon;
    this.emojis = new ArrayDataSource<string>(emojis.split(/\s+/));
  }
}

const CATEGORIES: EmojiCategory[] = [
  new EmojiCategory('emoji_category_people', $r('sys.symbol.face_smiling'), PEOPLE),
  // MCEmojiPicker draws an animal head and a burger with a drink for these two.
  new EmojiCategory('emoji_category_nature', $r('sys.symbol.animal_head'), NATURE),
  new EmojiCategory('emoji_category_food_and_drink', $r('sys.symbol.hamburgers'), FOOD_AND_DRINK),
  new EmojiCategory('emoji_category_activity', $r('sys.symbol.basketball'), ACTIVITY),
  new EmojiCategory('emoji_category_travel_and_places', $r('sys.symbol.car'), TRAVEL_AND_PLACES),
  new EmojiCategory('emoji_category_objects', $r('sys.symbol.lightbulb'), OBJECTS),
  new EmojiCategory('emoji_category_symbols', $r('sys.symbol.character_square'), SYMBOLS),
  new EmojiCategory('emoji_category_flags', $r('sys.symbol.flag'), FLAGS)
];

@Component
export struct EmojiPicker {
  /** Swift `selectedEmoji` — the tapped emoji, handed to the menu. */
  onPick?: (emoji: string) => void;
  /** The room under the source: `arrowDirection = .up` keeps the popover below it. */
  maxHeight: number = Number.MAX_VALUE;
  /** `selectedEmojiCategoryIndex` — the tinted bar icon, following the scroll. */
  @State private selectedCategory: number = 0;
  private scroller: ListScroller = new ListScroller();

  /** The popover's width, Swift `screenWidth - sideInset * 2`. */
  private pickerWidth(): number {
    return this.getUIContext().px2vp(display.getDefaultDisplaySync().width) - 2 * SIDE_INSET;
  }

  /**
   * `preferredContentSize.height`, `popoverWidth * 1.16`, cut to the room under the source as
   * UIKit cuts a popover. MCEmojiPicker permits only the `.up` arrow, so it never flips above
   * the source, however little room is left: it only gets shorter.
   */
  private pickerHeight(): number {
    return Math.min(this.pickerWidth() * HEIGHT_RATIO, this.maxHeight);
  }

  /** `MCEmojiCategoryType.emojiCategoryTitle`, MCEmojiPickerLocalizable. */
  private title(category: EmojiCategory): string {
    try {
      return this.getUIContext().getHostContext()?.resourceManager
        .getStringByNameSync(category.titleKey) ?? '';
    } catch (error) {
      return '';
    }
  }

  private pick(emoji: string): void {
    const handler: ((emoji: string) => void) | undefined = this.onPick;
    if (handler !== undefined) {
      handler(emoji);
    }
  }

  /** `MCEmojiSectionHeader` — pinned, on the popover's own background. */
  @Builder
  private header(category: EmojiCategory) {
    Text(this.title(category))
      .width('100%')
      .height(HEADER_HEIGHT)
      .align(Alignment.BottomStart)
      .fontSize(HEADER_FONT_SIZE)
      .fontColor(UNSELECTED_TINT)
      .padding({
        start: LengthMetrics.vp(HEADER_INSET),
        bottom: LengthMetrics.vp(HEADER_BOTTOM)
      })
      .backgroundColor(PICKER_BACKGROUND)
  }

  build() {
    Column() {
      List({ scroller: this.scroller }) {
        ForEach(CATEGORIES, (category: EmojiCategory) => {
          ListItemGroup({ header: this.header(category) }) {
            LazyForEach(category.emojis, (emoji: string) => {
              ListItem() {
                Text(emoji)
                  .fontSize(EMOJI_FONT_SIZE)
                  .width('100%')
                  .aspectRatio(1)
                  .textAlign(TextAlign.Center)
                  .onClick(() => {
                    this.pick(emoji);
                  })
              }
            }, (emoji: string) => emoji)
          }
        }, (category: EmojiCategory) => category.titleKey)
      }
      .lanes(EMOJIS_IN_ROW)
      .sticky(StickyStyle.Header)
      .scrollBar(BarState.Off)
      .layoutWeight(1)
      .padding({
        left: CONTENT_INSET,
        right: CONTENT_INSET
      })
      .onScrollIndex((start: number) => {
        this.selectedCategory = start;
      })

      Divider()
        .strokeWidth(SEPARATOR_HEIGHT)
        .color($r('sys.color.comp_divider'))

      // `categoriesStackView` — one equal cell per category; a tap jumps to its section.
      Row() {
        ForEach(CATEGORIES, (category: EmojiCategory, index: number) => {
          Column() {
            SymbolGlyph(category.icon)
              .fontSize(CATEGORY_ICON_SIZE)
              .fontColor([index === this.selectedCategory ? SELECTED_TINT : UNSELECTED_TINT])
          }
          .layoutWeight(1)
          .height('100%')
          .justifyContent(FlexAlign.Center)
          .onClick(() => {
            this.selectedCategory = index;
            this.scroller.scrollToIndex(index);
          })
        }, (category: EmojiCategory) => category.titleKey)
      }
      .width('100%')
      .height(this.pickerWidth() * CATEGORY_BAR_RATIO)
      .padding({
        left: CONTENT_INSET,
        right: CONTENT_INSET
      })
    }
    .width(this.pickerWidth())
    .height(this.pickerHeight())
    .backgroundColor(PICKER_BACKGROUND)
  }
}
